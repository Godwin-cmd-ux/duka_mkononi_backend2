{
  "expo": {
    "name": "Duka Mkononi",
    "slug": "duka-mkononi",
    "owner": "franklin19",
    "version": "1.0.0",
    "scheme": "dukamkononi",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/images/logo.png",
    "splash": {
      "image": "./assets/images/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.franklin19.dukamkononi"
    },
    "android": {
      "package": "com.franklin19.dukamkononi",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "favicon": "./assets/images/logo.png"
    },
    "plugins": [
      "expo-splash-screen",
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Duka Mkononi to use your location to help customers navigate to your business."
        }
      ],
      "expo-sqlite"
    ],
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/aa0a53be-ff5d-4543-a767-c54481a0cd47"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "root": "app"
      },
      "eas": {
        "projectId": "aa0a53be-ff5d-4543-a767-c54481a0cd47"
      }
    }
  }
}
