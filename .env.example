# =============================================
# DUKA MKONONI SERVER — ENVIRONMENT VARIABLES
# Copy this file to ".env" and fill in your values.
# On Render/Hosting dashboards, set these as environment variables instead.
# =============================================

# --- Server ---
PORT=10000
NODE_ENV=production

# --- Supabase (required) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# --- JWT Secret (REQUIRED — use a long random string in production) ---
JWT_SECRET=change-me-to-a-long-random-string

# --- Email (Nodemailer / Gmail app password) ---
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-gmail-app-password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_FROM=DukaMkononi <no-reply@dukamkononi.com>

# --- PesaPal (required for paid advertisements) ---
# Sandbox keys: https://www.pesapal.com/merchant/dashboard
PESAPAL_ENV=sandbox            # use 'live' when you are ready for real payments
PESAPAL_CONSUMER_KEY=your-pesapal-consumer-key
PESAPAL_CONSUMER_SECRET=your-pesapal-consumer-secret
# Register an IPN URL in the PesaPal dashboard, then paste the Notification ID:
PESAPAL_NOTIFICATION_ID=your-ipn-notification-id
# Public URLs of this server (must be reachable by PesaPal):
PESAPAL_CALLBACK_URL=https://www.dukamkononi.com/api/payments/pesapal-callback
PESAPAL_IPN_URL=https://www.dukamkononi.com/api/payments/pesapal-ipn

# --- Advertisement pricing (optional overrides) ---
# MATANGAZO_PRICE=3000
# MATANGAZO_DURATION_DAYS=30
